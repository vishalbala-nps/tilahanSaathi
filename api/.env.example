# SQLite for local dev, or Postgres/Supabase in prod:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./tilahan_saathi.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Path to the Firebase service account JSON (relative to project root)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Dev default: local Ollama + Gemma. Run `ollama pull gemma4` first.
LLM_MODEL=ollama_chat/gemma4
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90

# To switch to Gemini later: set LLM_MODEL=gemini/gemini-2.0-flash and
# uncomment the line below (get a key at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=change-me

# Agmarknet dashboard API, used to sync oilseed market prices (see /price)
AGMARKNET_API_URL=https://api.agmarknet.gov.in/v1/dashboard-data/
AGMARKNET_TIMEOUT_SECONDS=10
