# SQLite for now; swap to e.g. postgresql+asyncpg://user:pass@host/dbname later
DATABASE_URL=sqlite+aiosqlite:///./tilahan_saathi.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Path to the Firebase service account JSON (relative to project root)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
